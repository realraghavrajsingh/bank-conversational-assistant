# Copy to .env and fill in. The assistant reads it on start-up; docker compose passes it through.
# Keep comments on their own lines.

# ---- Model provider: gemini (default) or openai (any OpenAI-compatible endpoint) ----
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Local / self-hosted, e.g. Ollama (no key needed):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:8b

# ---- Mock core banking ----
BANK_BASE_URL=http://localhost:8001
BANK_SERVICE_KEY=dev-bank-service-key

# ---- Assistant ----
DEMO_LOGIN_ENABLED=true
